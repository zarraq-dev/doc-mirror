# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# VSCode workspace state (user-specific)
.vscode/
*.code-workspace

# JetBrains / Rider
.idea/

# Test / dev output (in case the script is run with output landing inside this folder)
test-output/
output/
.cache/

# Per-machine PowerShell history or local config
*.log

# User-specific sites configuration consumed by batch-mirror.ps1. The shipped
# sites.example.psd1 documents the format; users copy it to sites.psd1 and
# fill in their own URLs. sites.psd1 itself must never be committed.
sites.psd1
